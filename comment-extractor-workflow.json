              "name": "comment_selector",
              "value": ".comment-content",
              "type": "string"
            },
            {
              "id": "s3",
              "name": "author_selector",
              "value": ".comment-author",
              "type": "string"
            },
            {
              "id": "s4",
              "name": "date_selector",
              "value": ".comment-date",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; CommentExtractorBot/1.0)"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "d1000000-0000-4000-8000-000000000003",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {
              "key": "comment_text",
              "cssSelector": "={{ $('Config').first().json.comment_selector }}",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "comment_author",
              "cssSelector": "={{ $('Config').first().json.author_selector }}",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "comment_date",
              "cssSelector": "={{ $('Config').first().json.date_selector }}",
              "returnValue": "text",
              "returnArray": true
            }
          ]
        },
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000004",
      "name": "Extract Comments",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine the three extracted lists into one row per comment\nconst d = $input.first().json;\nconst texts = d.comment_text || [];\nconst authors = d.comment_author || [];\nconst dates = d.comment_date || [];\nconst url = $('Config').first().json.url;\n\nconst seen = new Set();\nconst rows = [];\ntexts.forEach((t, i) => {\n  const text = String(t).replace(/\\s+/g, ' ').trim();\n  if (!text || seen.has(text)) return; // skip blanks and duplicates\n  seen.add(text);\n  rows.push({ json: {\n    source_url: url,\n    author: String(authors[i] || '').replace(/\\s+/g, ' ').trim(),\n    date: String(dates[i] || '').replace(/\\s+/g, ' ').trim(),\n    comment: text,\n    extracted_at: new Date().toISOString()\n  }});\n});\n\nif (rows.length === 0) {\n  return [{ json: { source_url: url, comment: '', note: 'No comments found. Check selectors, or comments may load via JavaScript.' } }];\n}\nreturn rows;"
      },
      "id": "d1000000-0000-4000-8000-000000000005",
      "name": "Clean & Structure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "operation": "csv",
        "options": {
          "fileName": "comments.csv"
        }
      },
      "id": "d1000000-0000-4000-8000-000000000006",
      "name": "Convert to CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "/home/node/.n8n-files/comments.csv",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000007",
      "name": "Save CSV File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ]
    }
  ],
